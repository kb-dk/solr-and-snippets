<collection xmlns="http://exist-db.org/collection-config/1.0"
	    xmlns:t="http://www.tei-c.org/ns/1.0">
  <index>
    <lucene>
      <analyzer class="org.apache.lucene.analysis.standard.StandardAnalyzer"/>
      <text qname="t:TEI" />
      <text qname="@xml:id" />
    </lucene>
    <!-- removed: <create qname="t:div"  type="xs:string"/> and
         <create qname="t:text" type="xs:string"/>. These indexed the whole
         string value of an entire publication's div/text as one range-index
         key, overflowing the eXist BFile page size ("Key length exceeds page
         size! Skipping key" warnings), and apparently no query uses them-->
    <create qname="@xml:id" type="xs:string" />
  </index>
</collection>
